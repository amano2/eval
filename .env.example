# EvalKit Environment Configuration
DATABASE_URL=sqlite:///evalkit.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/evalkit

# OpenRouter Free LLM Access
OPENROUTER_API_KEY=your-openrouter-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=inclusionai/ling-3.2-flash:free
OPENROUTER_AVAILABLE_MODELS=inclusionai/ling-3.2-flash:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3-ultra-550b-a55b:free,perplexity/pplx-decider-v1.3:free

# Supabase Backend & Database
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-anon-key
SUPABASE_PROJECT_ID=your-project-id

# Local Payload Storage
OBJECT_STORAGE_DIR=./storage
SECRET_KEY=evalkit-secret-key-change-in-prod
API_PORT=8000
